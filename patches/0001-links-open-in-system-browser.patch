diff --git a/apps/desktop/src/store/external-links.grokbuild.test.ts b/apps/desktop/src/store/external-links.grokbuild.test.ts
new file mode 100644
index 00000000..a18ec117
--- /dev/null
+++ b/apps/desktop/src/store/external-links.grokbuild.test.ts
@@ -0,0 +1,12 @@
+import { describe, expect, it } from 'vitest'
+
+import { $alwaysExternalLinks } from './external-links'
+
+// GROK BUILD PATCH guard: if an upstream update restores the default, this fails
+// loudly instead of links quietly opening in the in-app pane again.
+describe('Grok Build link routing default', () => {
+  it('opens links in the system browser unless the user turned it off', () => {
+    expect($alwaysExternalLinks.get()).toBe(true)
+    expect(document.documentElement.getAttribute('data-link-routing')).toBe('system-first')
+  })
+})
diff --git a/apps/desktop/src/store/external-links.ts b/apps/desktop/src/store/external-links.ts
index f22c8c0c..68c52b76 100644
--- a/apps/desktop/src/store/external-links.ts
+++ b/apps/desktop/src/store/external-links.ts
@@ -17,18 +17,29 @@ import { persistBoolean, storedBoolean } from '@/lib/storage'
 
 const KEY = 'hermes.desktop.alwaysExternalLinks.v1'
 
-export const $alwaysExternalLinks = atom<boolean>(typeof window === 'undefined' ? false : storedBoolean(KEY, false))
+// GROK BUILD PATCH (patches/0001-links-open-in-system-browser.patch): default ON.
+// A clicked link opens in the system browser - where the user's logins,
+// extensions and tabs are - unless they turn this off in Settings. Upstream
+// defaults it off (bare click -> in-app pane).
+const GROK_BUILD_DEFAULT = true
+
+export const $alwaysExternalLinks = atom<boolean>(
+  typeof window === 'undefined' ? false : storedBoolean(KEY, GROK_BUILD_DEFAULT)
+)
 
 export function setAlwaysExternalLinks(on: boolean): void {
   $alwaysExternalLinks.set(on)
 }
 
 if (typeof window !== 'undefined') {
+  // Marker: a string literal survives minification, so the repair script can
+  // prove this patch is in the INSTALLED bundle, and it is visible in devtools.
+  document.documentElement.setAttribute('data-link-routing', 'system-first')
   $alwaysExternalLinks.subscribe(on => persistBoolean(KEY, on))
 
   window.addEventListener('storage', event => {
     if (event.key === KEY) {
-      $alwaysExternalLinks.set(storedBoolean(KEY, false))
+      $alwaysExternalLinks.set(storedBoolean(KEY, GROK_BUILD_DEFAULT))
     }
   })
 }
